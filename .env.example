# --- XRPL / x402 settlement -------------------------------------------------
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
XRPL_NETWORK=xrpl:1
XRPL_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
XRPL_WALLET_SEED=
XRPL_PAY_TO=

# --- Provider prices (must match providers_data.PROVIDERS_REGISTRY) ----------
XRPL_PRICE_DROPS=1200
TELEMETRY_PRICE_DROPS=600

# --- Unified provider gateway (all B2B + B2C routes on :8001) ----------------
PROVIDER_URL=http://localhost:8001
FREE_PROVIDER_URL=http://localhost:8001
PREMIUM_PROVIDER_URL=http://localhost:8001
TELEMETRY_PROVIDER_URL=http://localhost:8001
B2C_PROVIDER_URL=http://localhost:8001

# --- Agent behaviour ---------------------------------------------------------
# Confidence the agent works toward before it stops buying evidence.
# 0.85 reaches 87% with the satellite feed alone (one settlement).
# 0.92 makes the same agent buy the telemetry feed as well (two settlements).
LEDGER402_TARGET_CONFIDENCE=0.85
# Hard ceiling on settlements per run. A safety rail, not a tuning knob.
LEDGER402_MAX_PURCHASES=3
# Buyer's funding asset for premium settlements. XRP (default) pays exactly what is
# quoted, no SendMax. RLUSD funds the same XRP-denominated quote via a cross-currency
# SendMax, auto-bridged by the native XRPL DEX inside the one signed Payment.
LEDGER402_FUNDING_ASSET=XRP

# --- LLM (optional) ----------------------------------------------------------
# Leave blank to run fully deterministically: classification and Tier 1 report
# writing fall back to rules and a template. The LLM never decides to spend money.
#
# Cascade (one attempt each, no backoff): gemini-2.5-flash -> gemini-2.5-pro ->
# gemini-1.5-flash. GEMINI_MODEL overrides it: a single value pins one model;
# a comma-separated list sets a custom cascade.
GEMINI_API_KEY=
GEMINI_MODEL=
