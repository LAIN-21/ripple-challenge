# --- XRPL / x402 settlement -------------------------------------------------
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
XRPL_NETWORK=xrpl:1
XRPL_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
XRPL_WALLET_SEED=
XRPL_PAY_TO=

# --- Provider prices (must match data/providers.json) ------------------------
XRPL_PRICE_DROPS=1200
TELEMETRY_PRICE_DROPS=600

# --- Provider base URLs (scheme + host + port only; paths live in providers.json)
FREE_PROVIDER_URL=http://localhost:8001
PREMIUM_PROVIDER_URL=http://localhost:8002
TELEMETRY_PROVIDER_URL=http://localhost:8003

# --- Agent behaviour ---------------------------------------------------------
# Confidence the agent works toward before it stops buying evidence.
# 0.85 reaches 87% with the satellite feed alone (one settlement).
# 0.92 makes the same agent buy the telemetry feed as well (two settlements).
LEDGER402_TARGET_CONFIDENCE=0.85
# Hard ceiling on settlements per run. A safety rail, not a tuning knob.
LEDGER402_MAX_PURCHASES=3

# --- LLM (optional) ----------------------------------------------------------
# Leave both keys blank to run fully deterministically: classification and report
# writing fall back to rules and a template. The LLM never decides to spend money.
#
# Groq is the hackathon's provided inference stack (LPU hardware, lowest latency) and is
# preferred automatically when both keys are set. Gemini is a drop-in fallback if Groq
# credits are not available — set LLM_PROVIDER=gemini to force it even with both set.
#
# Within whichever provider is active, a model cascade absorbs "this model is
# overloaded" (503/429) by trying the next one — see ledger402/llm.py:GROQ/GEMINI for
# the default order. GROQ_MODEL / GEMINI_MODEL overrides it: a single value pins one
# model (no fallback); a comma-separated list sets a custom cascade.
GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# LLM_PROVIDER=groq | gemini   (optional: force a provider instead of auto-detecting)
